# Nutanix acceptance test environment
# -----------------------------------------------------------------------------
# Local:
#   cp .env.example .env   # then fill in real values (do not commit .env)
#   Go/Cursor loads .env via .vscode/settings.json (go.testEnvFile).
#   `make acc-test` also loads .env. Set TF_ACC=1 to run acceptance tests.
#

TF_ACC=1
CGO_ENABLED=0

# --- Auth (required) ---
NUTANIX_USERNAME="admin"
NUTANIX_PASSWORD="changeme"
# Optional: when set, X-Ntnx-Api-Key is used instead of basic auth
NUTANIX_API_KEY=""
NUTANIX_INSECURE=true

# --- Classic PC (set these OR the NC block below, not both as primary) ---
# Direct Prism Central IP/FQDN. Port is usually 9440.
NUTANIX_ENDPOINT="x.x.x.x"
NUTANIX_PORT=9440

# --- Nutanix Central (NC) ---
# For NC: leave NUTANIX_ENDPOINT unset (commented out). Do NOT set
# NUTANIX_ENDPOINT="" — a quoted empty string can break helpers that SSH to PC.
# NUTANIX_ENDPOINT=
# NUTANIX_PORT=443
# NUTANIX_CENTRAL_ENDPOINT="nconprem-x.x.x.x.example.com"
# NUTANIX_DOMAIN_NAME="my-domain"
# Leave empty for domain-PC IAM (recommended for iamv2 fixtures on domain AD/LDAP).
# Non-empty NUTANIX_TENANT_NAME forces NC IAM and enables tenant-admin tests.
# NUTANIX_TENANT_NAME=
# NUTANIX_USE_NC_IAM=false

# --- Prism Element (required for cluster / DP / firewall SSH helpers) ---
NUTANIX_PE_USERNAME="admin"
NUTANIX_PE_PASSWORD="changeme"

# --- Storage / images / protection (used by various acc packages) ---
NUTANIX_STORAGE_CONTAINER="00000000-0000-0000-0000-000000000000"
NOS_IMAGE_TEST_URL="test"
PROTECTION_RULES_TEST_FLAG=false

# --- Foundation ---
FOUNDATION_ENDPOINT="x.x.x.x"
FOUNDATION_PORT=8000

# --- NDB ---
NDB_ENDPOINT="x.x.x.x"
NDB_USERNAME="admin"
NDB_PASSWORD="changeme"

# --- Optional Cloudflare Access headers ---
# NUTANIX_HEADER_CF_ACCESS_CLIENT_ID="xxx.access"
# NUTANIX_HEADER_CF_ACCESS_CLIENT_SECRET="xxx"

# --- Optional tenant-admin membership fixtures (tenancyv2) ---
# NUTANIX_DOMAIN_EXT_ID=""
# NUTANIX_MEMBERSHIP_ROLE_EXT_ID=""
# NUTANIX_MEMBERSHIP_IDENTITY_EXT_ID=""
# NUTANIX_MEMBERSHIP_IDP_EXT_ID=""
# NUTANIX_MEMBERSHIP_PRINCIPAL_VALUE=""
# NUTANIX_MEMBERSHIP_IDENTITY_TYPE=""

# --- Terraform / test log level ---
# Valid levels: TRACE, DEBUG, INFO, WARN, ERROR, OFF
TF_LOG=ERROR
TF_LOG_SDK_HELPER_RESOURCE=OFF
TF_LOG_SDK=OFF
TF_LOG_CORE=OFF
