# Binaries for programs and plugins
*.dll
*.so
*.dylib
**/*.tfstate
**/*.tfstate.backup
**/.terraform*
*.log
setenv.sh
.env

# terraform.tfvars folded into config.yaml (single source of truth); kept out of
# git since it carried the PC creds. testenv/terraform reads config.yaml directly.
testenv/terraform/terraform.tfvars
# generated/secret-bearing test config backups produced by testenv/fill_test_config.py
*.json.bak
request_log
.DS_Store
dist/
pkg/
terraform-provider-nutanix

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
log.*

#exclude vendor
vendor
bin/*
build.sh

# autogenerated fies
*.autogenerated.*

.idea/

# Python bytecode cache
__pycache__/
*.pyc

# generated run artifacts from the testenv tooling
testenv/logs/
testenv/results/
